+// peek returns the byte after ch, reading more input if needed, or 0 at EOF.
+// It may move the buffer, so callers must take segments after it.
+func (s *source) peek() byte {
+	for s.r == s.e && s.ioerr == nil {
+		s.fill()
+	}
+	if s.r < s.e {
+		return s.buf[s.r]
+	}
+	return 0
+}
