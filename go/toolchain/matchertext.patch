+// mtString scans a matchertext literal M"(...)", M"[...]", or M"{...}" after its M;
+// the caller checked that an opener follows the quote. The content is any text
+// whose matchers (), [], {} match; the literal ends at the closer of its opening
+// matcher, which a quote must follow. The content is the literal's value verbatim:
+// no escapes, and the CRs it contains are kept.
+func (s *scanner) mtString() {
+	ok := true
+	s.nextch() // the quote
+	stack := []rune{s.ch}
+	s.nextch()
+	for ok && len(stack) > 0 {
+		switch s.ch {
+		case -1:
+			s.errorAtf(0, "matchertext literal not terminated")
+			ok = false
+			continue
+		case '(', '[', '{':
+			stack = append(stack, s.ch)
+		case ')', ']', '}':
+			if !closesMatcher(stack[len(stack)-1], s.ch) {
+				s.errorf("unmatched %c in matchertext literal", s.ch)
+				ok = false
+				continue
+			}
+			stack = stack[:len(stack)-1]
+		}
+		s.nextch()
+	}
+	if ok {
+		if s.ch == '"' {
+			s.nextch()
+		} else {
+			s.errorf("matchertext literal must end with a quote")
+			ok = false
+		}
+	}
+	s.setLit(StringLit, ok)
+}
+
+// isMatcherOpener reports whether c opens a matcher pair.
+func isMatcherOpener(c byte) bool {
+	return c == '(' || c == '[' || c == '{'
+}
+
+// closesMatcher reports whether the closer c matches the opener open.
+func closesMatcher(open, c rune) bool {
+	return open == '(' && c == ')' || open == '[' && c == ']' || open == '{' && c == '}'
+}
