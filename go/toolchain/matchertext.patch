+// matchertextContent returns the content of a matchertext literal M"(...)",
+// M"[...]", or M"{...}". The scanners accept such a literal only if the matchers
+// in its content match, so the content is the value verbatim.
+func matchertextContent(lit string) (string, bool) {
+	n := len(lit)
+	if n < 5 || lit[0] != 'M' || lit[1] != '"' || lit[n-1] != '"' {
+		return "", false
+	}
+	switch open, c := lit[2], lit[n-2]; {
+	case open == '(' && c == ')', open == '[' && c == ']', open == '{' && c == '}':
+		return lit[3 : n-2], true
+	}
+	return "", false
+}
