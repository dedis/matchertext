+// scanMatchertext scans a matchertext literal M"(...)", M"[...]", or M"{...}"
+// whose M was just scanned and whose quote an opener follows. The content is any
+// text whose matchers (), [], {} match; the literal ends at the closer of its
+// opening matcher, which a quote must follow. Like the compiler, it keeps CRs in
+// the content.
+func (s *Scanner) scanMatchertext() string {
+	offs := s.offset - 1 // the M
+	s.next()             // the quote
+	stack := []rune{s.ch}
+	s.next()
+	for len(stack) > 0 {
+		switch s.ch {
+		case eof:
+			s.error(offs, "matchertext literal not terminated")
+			return string(s.src[offs:s.offset])
+		case '(', '[', '{':
+			stack = append(stack, s.ch)
+		case ')', ']', '}':
+			if !closesMatcher(stack[len(stack)-1], s.ch) {
+				s.errorf(s.offset, "unmatched %c in matchertext literal", s.ch)
+				return string(s.src[offs:s.offset])
+			}
+			stack = stack[:len(stack)-1]
+		}
+		s.next()
+	}
+	if s.ch == '"' {
+		s.next()
+	} else {
+		s.error(s.offset, "matchertext literal must end with a quote")
+	}
+	return string(s.src[offs:s.offset])
+}
+
+// isMatcherOpener reports whether c opens a matcher pair.
+func isMatcherOpener(c byte) bool {
+	return c == '(' || c == '[' || c == '{'
+}
+
+// closesMatcher reports whether the closer c matches the opener open.
+func closesMatcher(open, c rune) bool {
+	return open == '(' && c == ')' || open == '[' && c == ']' || open == '{' && c == '}'
+}
