{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "minml",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_node"
      }
    },
    "_node": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "element"
        },
        {
          "type": "SYMBOL",
          "name": "char_ref"
        },
        {
          "type": "SYMBOL",
          "name": "quoted_string"
        },
        {
          "type": "SYMBOL",
          "name": "raw_block"
        },
        {
          "type": "SYMBOL",
          "name": "word"
        },
        {
          "type": "SYMBOL",
          "name": "text"
        }
      ]
    },
    "element": {
      "type": "PREC",
      "value": 1,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "FIELD",
            "name": "tag",
            "content": {
              "type": "ALIAS",
              "content": {
                "type": "SYMBOL",
                "name": "word"
              },
              "named": true,
              "value": "tag_name"
            }
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "FIELD",
                "name": "attrs",
                "content": {
                  "type": "SYMBOL",
                  "name": "attr_block"
                }
              },
              {
                "type": "BLANK"
              }
            ]
          },
          {
            "type": "FIELD",
            "name": "content",
            "content": {
              "type": "SYMBOL",
              "name": "content_block"
            }
          }
        ]
      }
    },
    "word": {
      "type": "PATTERN",
      "value": "[a-zA-Z_][a-zA-Z0-9_:-]*"
    },
    "content_block": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_node"
          }
        },
        {
          "type": "STRING",
          "value": "]"
        }
      ]
    },
    "attr_block": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "attribute"
          }
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "attribute": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "SYMBOL",
              "name": "word"
            },
            "named": true,
            "value": "attr_name"
          }
        },
        {
          "type": "STRING",
          "value": "="
        },
        {
          "type": "FIELD",
          "name": "value",
          "content": {
            "type": "SYMBOL",
            "name": "attr_value"
          }
        }
      ]
    },
    "attr_value": {
      "type": "CHOICE",
      "members": [
        {
          "type": "PREC",
          "value": 1,
          "content": {
            "type": "SYMBOL",
            "name": "element"
          }
        },
        {
          "type": "SYMBOL",
          "name": "content_block"
        },
        {
          "type": "SYMBOL",
          "name": "plain_value"
        },
        {
          "type": "SYMBOL",
          "name": "word"
        }
      ]
    },
    "plain_value": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PATTERN",
            "value": "[a-zA-Z_][a-zA-Z0-9_:-]*[^ \\t\\n\\r\\f{}\\[\\]<>a-zA-Z0-9_:-][^ \\t\\n\\r\\f{}\\[\\]<>]*"
          },
          {
            "type": "PATTERN",
            "value": "[^ \\t\\n\\r\\f{}\\[\\]<>a-zA-Z_][^ \\t\\n\\r\\f{}\\[\\]<>]*"
          }
        ]
      }
    },
    "char_ref": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "ALIAS",
              "content": {
                "type": "PATTERN",
                "value": "[a-zA-Z][a-zA-Z0-9]*"
              },
              "named": true,
              "value": "named_ref"
            },
            {
              "type": "ALIAS",
              "content": {
                "type": "PATTERN",
                "value": "#[0-9]+"
              },
              "named": true,
              "value": "decimal_ref"
            },
            {
              "type": "ALIAS",
              "content": {
                "type": "PATTERN",
                "value": "#x[0-9a-fA-F]+"
              },
              "named": true,
              "value": "hex_ref"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "]"
        }
      ]
    },
    "quoted_string": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "\"["
        },
        {
          "type": "PATTERN",
          "value": "[^\\]]*"
        },
        {
          "type": "STRING",
          "value": "]"
        }
      ]
    },
    "raw_block": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "+["
        },
        {
          "type": "PATTERN",
          "value": "[^\\]]*"
        },
        {
          "type": "STRING",
          "value": "]"
        }
      ]
    },
    "text": {
      "type": "PATTERN",
      "value": "[^\\[\\]{}<>a-zA-Z_]+"
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}