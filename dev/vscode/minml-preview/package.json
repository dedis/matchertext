{
  "name": "minml-preview",
  "displayName": "minml-livepreview",
  "description": "",
  "version": "0.0.1",
  "publisher": "local",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "minml",
        "extensions": [
          ".minml",
          ".m"
        ],
        "aliases": [
          "MinML",
          "minml"
        ]
      }
    ],
    "commands": [
      {
        "command": "minml-preview.showPreview",
        "title": "Open Preview",
        "category": "MinML",
        "icon": "$(book)"
      },
      {
        "command": "minml-preview.showPreviewToSide",
        "title": "Open Preview to the Side",
        "category": "MinML",
        "icon": "$(layout-sidebar-right)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceLangId == minml",
          "command": "minml-preview.showPreviewToSide",
          "group": "navigation"
        },
        {
          "when": "resourceLangId == minml",
          "command": "minml-preview.showPreview",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "MinML",
      "properties": {
        "minml.lspPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the minml-lsp binary. Leave empty to use the binary bundled with the extension."
        },
        "minml.debug": {
          "type": "boolean",
          "default": false,
          "description": "Enable debug logging for the language server."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.110.0",
    "@types/vscode-webview": "^1.57.5",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.4",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
