{
  "comments": {
    "blockComment": ["-[", "]"]
  },
  "brackets": [
    ["[", "]"],
    ["{", "}"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "(", "close": ")" },
    { "open": "\"[", "close": "]" },
    { "open": "+[", "close": "]" },
    { "open": "-[", "close": "]" },
    { "open": "?[", "close": "]" }
  ],
  "surroundingPairs": [
    ["[", "]"],
    ["{", "}"],
    ["(", ")"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "[a-zA-Z_][a-zA-Z0-9_:-]*\\s*\\[\\s*$",
    "decreaseIndentPattern": "^\\s*\\]"
  }
}
